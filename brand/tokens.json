{
  "$schema": "https://schemas.peachstudio.be/tokens",
  "name": "PEACH STUDIO design tokens",
  "color": {
    "cream":       { "value": "#F3F0E9", "comment": "page base" },
    "cream-deep":  { "value": "#ECE7DC", "comment": "alternate section base" },
    "surface":     { "value": "#FBFAF6", "comment": "cards" },
    "surface-2":   { "value": "#FFFFFF" },
    "ink":         { "value": "#211D18", "comment": "primary text, mono logo mark" },
    "ink-soft":    { "value": "#57514A", "comment": "secondary text, STUDIO in wordmark" },
    "ink-faint":   { "value": "#8A847B", "comment": "tertiary / labels" },
    "line":        { "value": "#DED7C9", "comment": "hairlines" },
    "line-soft":   { "value": "#E7E1D5" },
    "clay":        { "value": "#C2603A", "comment": "primary accent, peach body" },
    "clay-deep":   { "value": "#A84E2C", "comment": "serif emphasis / hover" },
    "clay-bright": { "value": "#D9693E", "comment": "CTA fill" },
    "clay-tint":   { "value": "#EDDFD4", "comment": "soft clay panel" },
    "clay-tint-2": { "value": "#F4E9DF" },
    "leaf":        { "value": "#5E7C2F", "comment": "logo leaf" }
  },
  "font": {
    "serif": "\"Newsreader\", Georgia, \"Times New Roman\", serif",
    "sans":  "\"Hanken Grotesk\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
    "mono":  "\"IBM Plex Mono\", ui-monospace, \"SFMono-Regular\", Menlo, monospace",
    "pixel": "\"Silkscreen\", \"IBM Plex Mono\", monospace"
  },
  "fontSize": {
    "display": "clamp(46px, 7.4vw, 92px)",
    "h1":      "clamp(40px, 6vw, 72px)",
    "h2":      "clamp(34px, 5vw, 58px)",
    "h3":      "clamp(26px, 3.2vw, 40px)",
    "lead":    "clamp(18px, 2.1vw, 22px)",
    "body":    "18px",
    "small":   "15px",
    "eyebrow": "12.5px"
  },
  "space": {
    "xs": "8px", "sm": "16px", "md": "24px", "lg": "48px",
    "xl": "72px", "2xl": "120px",
    "section-y": "clamp(72px, 11vw, 150px)",
    "gutter": "clamp(20px, 5vw, 56px)",
    "maxw": "1180px"
  },
  "radius": {
    "sm": "14px", "md": "16px", "lg": "22px", "pill": "100px"
  },
  "shadow": {
    "sm":  "0 14px 30px -14px rgba(168, 78, 44, 0.5)",
    "md":  "0 28px 56px -34px rgba(120, 70, 40, 0.5)",
    "lg":  "0 44px 80px -42px rgba(120, 70, 40, 0.55)",
    "cta": "0 10px 24px -10px rgba(194, 96, 58, 0.7)"
  },
  "motion": {
    "ease": "cubic-bezier(0.22, 1, 0.36, 1)",
    "transition": "0.3s cubic-bezier(0.22, 1, 0.36, 1)"
  }
}
